AUTH_FIRST_CLIENT_LOGIN_CODE=CREATEACODE
BASE_DOMAIN=openstad.local

DB_HOST=openstad-mysql
DB_USERNAME=USERNAME
DB_PASSWORD=PASSWORD

# Optionally set require-ssl
# DB_REQUIRE_SSL=true

# Optionally set enableCleartextPlugin:
# DB_ENABLE_CLEARTEXT_PLUGIN=false

# Optionally set a specific database authentication method, if not set the default password authentication is used
# DB_AUTH_METHOD=azure-auth-token

# Set the names of the databases. If not set and no DB_BASE_NAME then the defaults will be openstad(-api, -auth)
AUTH_DB_NAME=openstad-auth
API_DB_NAME=openstad-api

# Alternatively use DB_BASE_NAME, it will be appenden by (-api, -auth)
# DB_BASE_NAME=openstad

# Possibly not applicable anymore
MONGO_HOST=localhost

BASIC_AUTH_USER=openstad
BASIC_AUTH_PASSWORD=openstad

FROM_EMAIL_ADDRESS=user@example.xx
SMTP_PORT=465
SMTP_HOST=smtp.example.xx
SMTP_USERNAME=USERNAME
SMTP_PASSWORD=PASSWORD

# Salt for the reporting API's pseudonymous user ids. Must be a long random
# string and must stay stable: changing it changes every pseudonym.
OPENSTAD_REPORT_PSEUDONYM_SECRET=CHANGEMETOALONGRANDOMSTRING

FORCE_HTTP=true
SERVER_IP=IPNUMBER
DISABLE_RATE_LIMITER="false"

# Reporting MCP server (apps/mcp-server). One instance per Openstad
# installation: MCP_REPORTING_API_BASE_URL binds it to that installation's
# api-server. In a container MCP_HOST must be 0.0.0.0, and MCP_ALLOWED_HOSTS
# must then list the hostnames it is reached by — the MCP SDK only applies
# DNS-rebinding protection automatically on a localhost bind.
#
# Documented here for reference. server.js loads dotenv relative to the process
# working directory, so `npm start --workspace=apps/mcp-server` reads
# apps/mcp-server/.env rather than this file — copy the block there, or export the
# variables. The MCP server has no docker-compose service and no Helm template
# yet; both land with its deployment (see apps/mcp-server/README.md).
MCP_REPORTING_API_BASE_URL=http://localhost:31410
MCP_HOST=127.0.0.1
MCP_PORT=3900
# MCP_ALLOWED_HOSTS=reporting-mcp.example.org
# Set 'true' for debugging when NODE_ENV is set to 'production'
# VERBOSE_LOGGING=false