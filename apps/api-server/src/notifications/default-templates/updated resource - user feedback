<!-- template: updated resource - user feedback -->
<subject>Je inzending op {{ project.title }} is aangepast</subject>
<body>
  <mjml>
    <mj-body>
      {% if logo %}
      <mj-section>
        <mj-column width="200px">
          <mj-image src="{{ logo }}"></mj-image>
        </mj-column>
      </mj-section>
      {% endif %}
      <mj-raw>
        <!-- Mail context -->
      </mj-raw>
      <mj-section>
        <mj-column width="500px">
          <mj-text font-size="20px" font-family="Helvetica Neue" color="{{ styling.accentColor }}">Er is een inzending aangepast.</mj-text>
          <mj-text>Beste {{user.name}},</mj-text>
          <mj-text color="#525252">U heeft recentelijk een van uw inzendingen aangepast. U kunt deze hieronder direct bekijken:</mj-text>
          <mj-button background-color="{{ styling.accentColor }}" href="{{redirectUrl}}">Weergeven</mj-button>
        </mj-column>
      </mj-section>
      <mj-raw>
        <!-- ALternate link -->
      </mj-raw>
      <mj-section>
        <mj-column width="400px">
          <mj-text>Of gebruik deze link in je browser:</mj-text>
        </mj-column>
        <mj-column>
          <mj-text>{{redirectUrl}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
</body>