<!-- template: contact message - user -->
<subject>Bericht ontvangen over een inzending</subject>
<body>
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica Neue, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#333333" />
      <mj-divider border-width="1px" border-color="#dddddd" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="32px 24px">
      <mj-column>
        {% if logo %}
        <mj-image src="{{logo}}" align="left" width="160px" alt="" padding-bottom="16px" />
        {% endif %}
        <mj-text><h1 style="font-size:22px;font-weight:bold;line-height:1.3;margin:0">Bericht ontvangen over een inzending</h1></mj-text>
        <mj-divider />
        <mj-text>
          Beste {{user.name}},<br/>
          <br/>
          {{senderName}} heeft een bericht gestuurd over de inzending "{{resource.title}}".
        </mj-text>
        {% if message %}
        <mj-text padding-bottom="0"><h2 style="font-size:17px;font-weight:bold;margin:0">Bericht van {{senderName}}</h2></mj-text>
        <mj-text>"{{message}}"</mj-text>
        {% endif %}
        <mj-text padding-bottom="0"><h2 style="font-size:17px;font-weight:bold;margin:0">Reageren</h2></mj-text>
        <mj-text>Reageren kan met een e-mail naar <a href="mailto:{{senderEmail}}">{{senderEmail}}</a>.</mj-text>
        <mj-divider />
        <mj-text align="center" font-size="13px" color="#777777">Dit is een automatisch bericht. Antwoorden op deze e-mail is niet mogelijk.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
</body>
