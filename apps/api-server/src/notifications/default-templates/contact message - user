<!-- template: contact message - user -->
<subject>Bericht ontvangen over een inzending</subject>
<body>
<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <h1>Bericht ontvangen over een inzending</h1>
          Beste {{user.name}},<br/>
          <br/>
          {{senderName}} heeft een bericht gestuurd over de inzending "{{resource.title}}".<br/>
        </mj-text>
        <mj-text>
          <strong>{{senderName}}</strong><br/>
          "{{message}}"
        </mj-text>
        <mj-text>
          Reageren kan met een e-mail naar <a href="mailto:{{senderEmail}}">{{senderEmail}}</a>.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
</body>
