<!-- template: new published resource - admin update -->
<subject>Nieuwe resource op {{project.title}}</subject>
<content>
{
  "heading": "Nieuwe inzending ontvangen",
  "greeting": "Beste beheerder,",
  "intro": "Er is een nieuwe inzending binnengekomen. Hieronder vind je de details:",
  "buttonLabel": "Bekijk de inzending",
  "buttonUrl": "{{ redirectUrl }}",
  "footer": "Dit is een automatisch bericht, antwoorden op deze e-mail is niet mogelijk."
}
</content>
<body>
  <mjml>
    <mj-body background-color="#f6f6f7">
      <mj-section background-color="#ffffff" padding="20px">
        <mj-column>
            <mj-image src="{{ logo or (imagePath + '/logo-openstad.png') }}" width="150px"></mj-image>
            <mj-text font-size="20px" color="#333333" font-family="Helvetica" align="center">Nieuwe inzending ontvangen</mj-text>
            <mj-divider border-color="#cccccc" border-width="1px"></mj-divider>
            <mj-divider border-width="0" padding="10px" />
            <mj-text line-height="1.3" font-size="16px" color="#555555" font-family="Helvetica">Beste beheerder,</mj-text>
            <mj-text line-height="1.3" font-size="16px" color="#555555" font-family="Helvetica">Er is een nieuwe inzending binnengekomen. Hieronder vind je de details:</mj-text>
            <mj-divider border-width="0" padding="10px" />
            <mj-text font-size="14px" line-height="22px" color="#444" font-family="Helvetica">
              {{ submissionContent | safe }}
            </mj-text>
            {% if redirectUrl %}
            <mj-button align="left" line-height="1.3" font-size="15px" font-family="Helvetica" background-color="#00325F" href="{{ redirectUrl }}">Bekijk de inzending</mj-button>
            <mj-divider border-width="0" padding="10px" />
            <mj-text line-height="1.3" font-size="16px" color="#555555" font-family="Helvetica">Of gebruik deze link in je browser:</mj-text>
            <mj-text line-height="1.3" font-size="14px" color="#00325F" font-family="Helvetica">{{ redirectUrl }}</mj-text>
            {% endif %}
            <mj-divider border-width="0" padding="10px" />
            <mj-divider border-color="#cccccc" border-width="1px"></mj-divider>
            <mj-text line-height="1.3" font-size="14px" color="#999999" font-family="Helvetica" align="center">Dit is een automatisch bericht, antwoorden op deze e-mail is niet mogelijk.</mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
</body>
